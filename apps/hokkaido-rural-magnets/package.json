{
  "name": "hokkaido-rural-magnets",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/leaflet": "^1.9.21",
    "expo": "^54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-iap": "^4.6.0",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-mail-composer": "~15.0.8",
    "expo-screen-orientation": "~9.0.9",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-view-shot": "4.0.3",
    "react-native-webview": "13.15.0",
    "react-native-zip-archive": "^8.0.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "eas build --platform android --profile production",
    "build:android:local": "EAS_BUILD_PROFILE=production expo prebuild --platform android --no-install && cd android && ./gradlew bundleRelease",
    "verify:aab": "node scripts/verify-aab-version.mjs",
    "build:ios": "eas build --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generate:station-data-manifest": "node scripts/generate-station-data-manifest.mjs",
    "build:stations": "node scripts/build-hokkaido-municipalities.mjs && node scripts/build-hokkaido-municipality-boundaries.mjs && node scripts/generate-station-data-manifest.mjs",
    "build:stations:offline": "node scripts/build-hokkaido-municipalities.mjs --offline && node scripts/build-hokkaido-municipality-boundaries.mjs && node scripts/generate-station-data-manifest.mjs",
    "build:boundaries": "node scripts/build-hokkaido-municipality-boundaries.mjs",
    "prebuild:ios": "expo prebuild --platform ios",
    "prebuild:android": "expo prebuild --platform android",
    "postinstall": "patch-package"
  },
  "private": true
}
