# Supabase — Project Settings → API (NOT the Postgres connection string)
EXPO_PUBLIC_SUPABASE_URL=https://lwixlvymyhllspotmjze.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard

# Castle data updates (Supabase Storage public bucket: castle-data)
# Upload assets/castles.json, assets/i18n/castle-content.zh-Hant.json, and assets/data-manifest.json
# Bump data-manifest.json "version" whenever you publish new castle data.

# Google OAuth — create THREE clients in Google Cloud Console (see README)
# Web client: HTTPS origins/redirects for Supabase only
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client: bundle ID com.japancastles.map
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android client: package com.japancastles.map + SHA-1
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
