# Supabase — Project Settings → API (NOT the Postgres connection string)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional: for `npm run upload:station-data` (Dashboard → API → service_role)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Remote station data (Supabase Storage public bucket: station-data)
# Upload assets/stations.json and assets/data-manifest.json
# Bump data-manifest.json "version" whenever you publish new station data.
