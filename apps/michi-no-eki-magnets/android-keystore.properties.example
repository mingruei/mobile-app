# Copy to android/keystore.properties (gitignored via /android) and fill in
# machine-specific absolute paths. Do NOT use ~/ — Gradle treats it as a
# relative folder under android/app/.
#
#   eas credentials -p android  →  production  →  Keystore  →  Download
#
# Verify SHA-1 matches Google Play upload key:
#   keytool -list -v -keystore /absolute/path/upload-keystore.jks -alias YOUR_ALIAS
# Expected: 3B:90:D1:8A:0A:1C:F2:B7:64:AE:B4:47:86:8D:0C:FF:FD:66:70:B6
#
# Then build release locally:
#   cd android && ./gradlew bundleRelease
# Verify AAB signature before upload:
#   keytool -printcert -jarfile app/build/outputs/bundle/release/*.aab

storeFile=/Users/YOUR_USERNAME/upload-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
