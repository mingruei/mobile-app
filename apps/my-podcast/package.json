{
  "name": "my-podcast",
  "version": "1.0.2",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "expo start",
    "ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios --device",
    "ios:xcode": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo prebuild --platform ios && open ios/AudioFlow.xcworkspace",
    "prebuild:ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo prebuild --platform ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "generate:icon": "node scripts/generate-icon.mjs",
    "android": "expo run:android"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^54.0.0",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-file-system": "~19.0.24",
    "expo-keep-awake": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "watch-transfer": "file:./modules/watch-transfer"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  }
}
